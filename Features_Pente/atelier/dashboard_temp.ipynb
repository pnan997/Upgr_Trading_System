    import pandas as pd
    import matplotlib.pyplot as plt
    import numpy as np
    import glob
    import os
    from matplotlib.ticker import MultipleLocator
    
    # --- CONFIGURATION DES CHEMINS ---
    DIRS = [
        '/app/working/workspaces/FinCodeur95/duckdb/Features_Pente/',
